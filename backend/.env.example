# ─── LLM Provider Configuration ───────────────────────────────────────
# The Decision Engine works fully without an LLM (deterministic mode).
# Configure one of the following to enable AI-assisted explanations.

# Provider type: "ollama" | "openai" | "none" (default: "none")
LLM_PROVIDER=none

# ─── Ollama (local) ───────────────────────────────────────────────────
# Requires a local Ollama server. NOT accessible from cloud-hosted apps.
# Install: https://ollama.com
# Pull a model: ollama pull llama3.1
# Start server: ollama serve (default port 11434)
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_MODEL=llama3.1

# ─── OpenAI-compatible endpoint ───────────────────────────────────────
# Works with OpenAI, Azure OpenAI, LM Studio, vLLM, OpenRouter, etc.
# Set LLM_PROVIDER=openai and provide a valid API key.
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4o-mini

# ─── General LLM Settings ─────────────────────────────────────────────
# Request timeout in seconds
LLM_TIMEOUT=30
# Max tokens for completions
LLM_MAX_TOKENS=1024
# Temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.3

# ─── API Server ───────────────────────────────────────────────────────
# CORS origins (comma-separated). Default allows the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
